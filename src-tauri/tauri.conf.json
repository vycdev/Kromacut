{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Kromacut",
    "version": "4.1.0",
    "identifier": "com.kromacut.lithophane",
    "build": {
        "frontendDist": "../dist",
        "devUrl": "http://localhost:5173",
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build"
    },
    "app": {
        "windows": [
            {
                "title": "Kromacut",
                "width": 1400,
                "height": 900,
                "minWidth": 1000,
                "minHeight": 700,
                "resizable": true,
                "fullscreen": false,
                "dragDropEnabled": false
            }
        ],
        "security": {
            "csp": "default-src 'self'; connect-src 'self' https://kromacut.com; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; worker-src 'self' blob:"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "fileAssociations": [
            {
                "ext": ["kfil", "kapp"],
                "name": "Kromacut.FilamentProfile",
                "description": "Kromacut filament profile",
                "mimeType": "application/x-kromacut-filament-profile",
                "role": "Editor",
                "rank": "Owner",
                "exportedType": {
                    "identifier": "com.kromacut.filament-profile",
                    "conformsTo": ["public.json"]
                }
            },
            {
                "ext": ["kpal"],
                "name": "Kromacut.Palette",
                "description": "Kromacut color palette",
                "mimeType": "application/x-kromacut-palette",
                "role": "Editor",
                "rank": "Owner",
                "exportedType": {
                    "identifier": "com.kromacut.palette",
                    "conformsTo": ["public.json"]
                }
            }
        ],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "webviewInstallMode": {
                "type": "embedBootstrapper",
                "silent": true
            },
            "nsis": {
                "minimumWebview2Version": "114.0.1823.67",
                "installerHooks": "windows/file-associations.nsh"
            }
        },
        "macOS": {
            "signingIdentity": "-",
            "entitlements": null
        }
    }
}
